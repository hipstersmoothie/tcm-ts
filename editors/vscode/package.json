{
  "name": "ucm-ts",
  "displayName": "ucm-ts",
  "description": "The ucm-ts codebase in VS Code: a namespace sidebar, definitions as documents, usages, type search, and Unison-style status, watch values and save commands for scratch files",
  "version": "0.5.0",
  "publisher": "ucm-ts",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.ucm/codebase.sqlite"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ucm",
          "title": "ucm",
          "icon": "media/ucm.svg"
        }
      ]
    },
    "views": {
      "ucm": [
        {
          "id": "ucm.apps",
          "name": "Apps"
        },
        {
          "id": "ucm.codebase",
          "name": "Codebase"
        },
        {
          "id": "ucm.data",
          "name": "Data"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ucm.codebase",
        "contents": "The codebase is empty. Write definitions in a scratch file (scratch.ts) and use **Add to codebase** above them."
      },
      {
        "view": "ucm.apps",
        "contents": "No apps yet. An app is a browser entry point: a function that runs in the browser, takes no arguments, and isn't called by other code (like `app.main`)."
      },
      {
        "view": "ucm.data",
        "contents": "No data yet. Tables are declared with `table<Row>(\"name\")` from `#ucm/server`; their rows appear here once an app writes some."
      }
    ],
    "commands": [
      {
        "command": "ucm.add",
        "title": "Add this file's definitions to the codebase",
        "category": "ucm"
      },
      {
        "command": "ucm.update",
        "title": "Update the codebase from this file",
        "category": "ucm"
      },
      {
        "command": "ucm.findByType",
        "title": "Find by type",
        "category": "ucm",
        "icon": "$(search)"
      },
      {
        "command": "ucm.refresh",
        "title": "Refresh",
        "category": "ucm",
        "icon": "$(refresh)"
      },
      {
        "command": "ucm.openDefinition",
        "title": "Open",
        "category": "ucm"
      },
      {
        "command": "ucm.editDefinition",
        "title": "Edit in a scratch file",
        "category": "ucm",
        "icon": "$(edit)"
      },
      {
        "command": "ucm.rename",
        "title": "Rename",
        "category": "ucm"
      },
      {
        "command": "ucm.findUsages",
        "title": "Find usages",
        "category": "ucm",
        "icon": "$(references)"
      },
      {
        "command": "ucm.copyHash",
        "title": "Copy hash",
        "category": "ucm"
      },
      {
        "command": "ucm.runDefinition",
        "title": "Run",
        "category": "ucm",
        "icon": "$(play)"
      },
      {
        "command": "ucm.startApp",
        "title": "Start app",
        "category": "ucm",
        "icon": "$(play)"
      },
      {
        "command": "ucm.stopApp",
        "title": "Stop app",
        "category": "ucm",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ucm.openApp",
        "title": "Open app",
        "category": "ucm",
        "icon": "$(globe)"
      },
      {
        "command": "ucm.openAppExternal",
        "title": "Open app in external browser",
        "category": "ucm",
        "icon": "$(link-external)"
      },
      {
        "command": "ucm.showAppLog",
        "title": "Show app log",
        "category": "ucm",
        "icon": "$(output)"
      },
      {
        "command": "ucm.showTable",
        "title": "Open table",
        "category": "ucm",
        "icon": "$(table)"
      },
      {
        "command": "ucm.migrateTable",
        "title": "Migrate rows to the current row type",
        "category": "ucm",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ucm.openTableDefinition",
        "title": "Go to definition",
        "category": "ucm",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ucm.findByType",
          "when": "view == ucm.codebase",
          "group": "navigation@1"
        },
        {
          "command": "ucm.refresh",
          "when": "view == ucm.codebase",
          "group": "navigation@2"
        },
        {
          "command": "ucm.refresh",
          "when": "view == ucm.apps",
          "group": "navigation@1"
        },
        {
          "command": "ucm.refresh",
          "when": "view == ucm.data",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ucm.editDefinition",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "inline@1"
        },
        {
          "command": "ucm.findUsages",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "inline@2"
        },
        {
          "command": "ucm.openDefinition",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "1_open@1"
        },
        {
          "command": "ucm.editDefinition",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "1_open@2"
        },
        {
          "command": "ucm.findUsages",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "2_navigate@1"
        },
        {
          "command": "ucm.runDefinition",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "2_navigate@2"
        },
        {
          "command": "ucm.rename",
          "when": "view == ucm.codebase && (viewItem == definition || viewItem == namespace)",
          "group": "3_change@1"
        },
        {
          "command": "ucm.copyHash",
          "when": "(view == ucm.codebase || view == ucm.apps) && viewItem =~ /^definition/",
          "group": "4_copy@1"
        },
        {
          "command": "ucm.startApp",
          "when": "view == ucm.apps && viewItem == app.stopped",
          "group": "inline@1"
        },
        {
          "command": "ucm.openApp",
          "when": "view == ucm.apps && viewItem == app.running",
          "group": "inline@1"
        },
        {
          "command": "ucm.showAppLog",
          "when": "view == ucm.apps && viewItem == app.running",
          "group": "inline@2"
        },
        {
          "command": "ucm.stopApp",
          "when": "view == ucm.apps && viewItem == app.running",
          "group": "inline@3"
        },
        {
          "command": "ucm.openAppExternal",
          "when": "view == ucm.apps && viewItem == app.running",
          "group": "1_open@1"
        },
        {
          "command": "ucm.startApp",
          "when": "view == ucm.codebase && viewItem == definition.app",
          "group": "inline@0"
        },
        {
          "command": "ucm.showTable",
          "when": "view == ucm.data && viewItem =~ /^table/",
          "group": "inline@1"
        },
        {
          "command": "ucm.migrateTable",
          "when": "view == ucm.data && viewItem == table.older",
          "group": "inline@2"
        },
        {
          "command": "ucm.openTableDefinition",
          "when": "view == ucm.data && viewItem =~ /^table/",
          "group": "1_open@1"
        },
        {
          "command": "ucm.migrateTable",
          "when": "view == ucm.data && viewItem == table.older",
          "group": "2_change@1"
        },
        {
          "command": "ucm.openApp",
          "when": "view == ucm.codebase && viewItem == definition.app.running",
          "group": "inline@0"
        },
        {
          "command": "ucm.stopApp",
          "when": "view == ucm.codebase && viewItem == definition.app.running",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ucm.openDefinition",
          "when": "false"
        },
        {
          "command": "ucm.copyHash",
          "when": "false"
        },
        {
          "command": "ucm.findUsages",
          "when": "false"
        },
        {
          "command": "ucm.showTable",
          "when": "false"
        },
        {
          "command": "ucm.openAppExternal",
          "when": "false"
        },
        {
          "command": "ucm.showAppLog",
          "when": "false"
        },
        {
          "command": "ucm.migrateTable",
          "when": "false"
        },
        {
          "command": "ucm.openTableDefinition",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ucm-ts",
      "properties": {
        "ucm.path": {
          "type": "string",
          "default": "ucm",
          "description": "The ucm executable: `ucm` on your PATH, or the path to ucm's packages/cli/bin/ucm.js (run with Node; spaces are fine), or a command line with \"quotes\" around words containing spaces."
        }
      }
    },
    "typescriptServerPlugins": [
      {
        "name": "ucm-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "ucm-ts-plugin": "file:./ts-plugin"
  }
}
