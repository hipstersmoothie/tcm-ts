{
  "name": "ucm-ts",
  "displayName": "ucm-ts",
  "description": "The ucm-ts codebase in VS Code: a namespace sidebar, definitions as documents, usages, type search, and Unison-style status, watch values and save commands for scratch files",
  "version": "0.2.0",
  "publisher": "ucm-ts",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.ucm/codebase.sqlite"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ucm",
          "title": "ucm",
          "icon": "media/ucm.svg"
        }
      ]
    },
    "views": {
      "ucm": [
        {
          "id": "ucm.codebase",
          "name": "Codebase"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ucm.codebase",
        "contents": "The codebase is empty. Write definitions in a scratch file (scratch.ts) and use **Add to codebase** above them."
      }
    ],
    "commands": [
      {
        "command": "ucm.add",
        "title": "Add this file's definitions to the codebase",
        "category": "ucm"
      },
      {
        "command": "ucm.update",
        "title": "Update the codebase from this file",
        "category": "ucm"
      },
      {
        "command": "ucm.findByType",
        "title": "Find by type",
        "category": "ucm",
        "icon": "$(search)"
      },
      {
        "command": "ucm.refresh",
        "title": "Refresh",
        "category": "ucm",
        "icon": "$(refresh)"
      },
      {
        "command": "ucm.openDefinition",
        "title": "Open",
        "category": "ucm"
      },
      {
        "command": "ucm.editDefinition",
        "title": "Edit in a scratch file",
        "category": "ucm",
        "icon": "$(edit)"
      },
      {
        "command": "ucm.rename",
        "title": "Rename",
        "category": "ucm"
      },
      {
        "command": "ucm.findUsages",
        "title": "Find usages",
        "category": "ucm",
        "icon": "$(references)"
      },
      {
        "command": "ucm.copyHash",
        "title": "Copy hash",
        "category": "ucm"
      },
      {
        "command": "ucm.runDefinition",
        "title": "Run",
        "category": "ucm",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ucm.findByType",
          "when": "view == ucm.codebase",
          "group": "navigation@1"
        },
        {
          "command": "ucm.refresh",
          "when": "view == ucm.codebase",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ucm.editDefinition",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "inline@1"
        },
        {
          "command": "ucm.findUsages",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "inline@2"
        },
        {
          "command": "ucm.openDefinition",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "1_open@1"
        },
        {
          "command": "ucm.editDefinition",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "1_open@2"
        },
        {
          "command": "ucm.findUsages",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "2_navigate@1"
        },
        {
          "command": "ucm.runDefinition",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "2_navigate@2"
        },
        {
          "command": "ucm.rename",
          "when": "view == ucm.codebase && (viewItem == definition || viewItem == namespace)",
          "group": "3_change@1"
        },
        {
          "command": "ucm.copyHash",
          "when": "view == ucm.codebase && viewItem == definition",
          "group": "4_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ucm.openDefinition",
          "when": "false"
        },
        {
          "command": "ucm.copyHash",
          "when": "false"
        },
        {
          "command": "ucm.findUsages",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ucm-ts",
      "properties": {
        "ucm.path": {
          "type": "string",
          "default": "ucm",
          "description": "The ucm executable: `ucm` on your PATH, or the path to ucm's packages/cli/bin/ucm.js (run with Node; spaces are fine), or a command line with \"quotes\" around words containing spaces."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
