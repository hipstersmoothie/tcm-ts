{
  "name": "tcm-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning 'packages/*/test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "tcm": "scripts/codebase.sh",
    "verify": "sh scripts/codebase.sh run tcmts.dev.verify",
    "compare-compilers": "scripts/compare-compilers.sh",
    "build": "sh scripts/codebase.sh pack tcm-ts --out ../dist/package",
    "docs:site": "sh scripts/codebase.sh run tcmts.dev.site",
    "docs:dev": "sh scripts/codebase.sh run tcmts.dev.siteDev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "marked": "^18.1.2",
    "shiki": "^4.5.0",
    "typescript": "7.1.0-beta",
    "typescript6": "npm:typescript@^6.0.3"
  },
  "bin": {
    "tcm": "packages/cli/bin/tcm.js"
  },
  "dependencies": {
    "@tcm/cli": "workspace:*"
  },
  "version": "0.1.0"
}
