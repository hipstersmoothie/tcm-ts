{
  "name": "tcm-ts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning 'packages/*/test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "tcm": "scripts/codebase.sh",
    "verify": "scripts/verify.sh",
    "selfhost": "scripts/selfhost.sh",
    "compare-compilers": "scripts/compare-compilers.sh",
    "build": "node scripts/build.ts",
    "test:package": "scripts/test-package.sh",
    "docs:site": "node scripts/docs-site.ts",
    "docs:dev": "node scripts/docs-dev.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "marked": "^18.1.2",
    "shiki": "^4.5.0",
    "typescript": "7.1.0-beta",
    "typescript6": "npm:typescript@^6.0.3"
  },
  "bin": {
    "tcm": "packages/cli/bin/tcm.js"
  },
  "dependencies": {
    "@tcm/cli": "workspace:*"
  },
  "version": "0.1.0"
}
